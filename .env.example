# Local development only. Copy this file to .env; never commit real credentials.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://agent:agent@127.0.0.1:5432/agent
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_PORT=5432
REDIS_PORT=6379

# Not read by the scaffold. Configure when the corresponding integration exists.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
E2B_API_KEY=
AWS_REGION=
S3_BUCKET=
OTEL_EXPORTER_OTLP_ENDPOINT=
