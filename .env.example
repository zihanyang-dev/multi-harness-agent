# Local development only. Copy this file to .env; never commit real credentials.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://agent:agent@127.0.0.1:5432/agent?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_PORT=5432
REDIS_PORT=6379

# Explicit opt-in. The default serves liveness without opening infrastructure or native credentials.
AGENT_BACKEND_ENABLED=0
# Server only; use secret injection outside local development. Native public sign-up is off by default.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_ALLOW_SIGN_UP=0
# Both server and worker must bind the same immutable Pi profile and physical storage identity.
PI_PROVIDER=
PI_MODEL=
PI_STORAGE_ID=
# Worker only. Required explicit native provider credential; no personal Pi auth discovery.
PI_API_KEY=
PI_STATE_ROOT=/var/lib/multi-harness/pi
TURN_MAX_RUN_MS=120000

# Future integrations; not read by this text-v1 product path.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
E2B_API_KEY=
AWS_REGION=
S3_BUCKET=
OTEL_EXPORTER_OTLP_ENDPOINT=
