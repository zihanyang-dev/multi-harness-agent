{
  "name": "@multi-harness/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=development --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@multi-harness/harness": "workspace:*",
    "@multi-harness/protocol": "workspace:*",
    "@multi-harness/sandbox": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.223.0",
    "bullmq": "6.3.12",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  }
}
